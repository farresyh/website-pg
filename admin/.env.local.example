# Copy to .env.local for local development.
# ADR-121: the admin is authorized by Laravel's session cookie, which the
# browser only sends to the same site — so point it at `php artisan serve`
# on localhost, not a *.test Herd site (backend/AGENTS.md gotcha 6).
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_REVERB_APP_KEY=local-dev-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http