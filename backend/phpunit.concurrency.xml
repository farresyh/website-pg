<?xml version="1.0" encoding="UTF-8"?>
<!--
  Separate config for tests that need REAL row-level locking (MySQL via
  docker-compose.yml), which the default sqlite :memory: suite (phpunit.xml)
  cannot exercise faithfully — SQLite locks at the file level, not per-row.
  Run with: php artisan test -c phpunit.concurrency.xml
  Requires: docker compose up -d (see docker-compose.yml)
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CATALOG_PACKAGES_CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="kerox"/>
        <env name="DB_USERNAME" value="kerox"/>
        <env name="DB_PASSWORD" value="kerox"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Tests never use live credentials. backend/.env holds the real keys for local work; CI has none.
             Forced blank so a test that forgets to fake an HTTP call cannot send a real email, create a real
             CHIP purchase, call a real supplier or bill the Gemini key. -->
        <env name="PLUNK_API_KEY" value="" force="true"/>
        <env name="CHIP_SECRET_KEY" value="" force="true"/>
        <env name="CHIP_BRAND_ID" value="" force="true"/>
        <env name="GAMEVION_API_KEY" value="" force="true"/>
        <env name="GAMEVION_BEARER_TOKEN" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="SUPPLIER_PROXY_URL" value="" force="true"/>
    </php>
</phpunit>
