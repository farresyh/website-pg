# Locally-compiled provider/package discovery cache — generated against
# the *local* composer install (dev deps included). Shipping these into
# a --no-dev image clobbers what the image's own `composer dump-autoload`
# regenerates, referencing dev-only providers (e.g. laravel/pail) that
# were never installed there. Let the image regenerate its own.
bootstrap/cache/*.php
